{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://particleml.local/schemas/2.1.0/run-record.schema.json",
  "title": "particleML run record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "command",
    "started_at",
    "completed_at",
    "status",
    "config_sha256",
    "input_artifacts",
    "software",
    "model_input_fields",
    "model_input_sha256"
  ],
  "properties": {
    "schema_version": {"const": "2.1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["completed", "failed"]},
    "config_sha256": {"$ref": "#/$defs/sha256"},
    "input_artifacts": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/sha256"}
    },
    "software": {
      "type": "object",
      "additionalProperties": false,
      "required": ["particleml_version", "python_version", "git_commit"],
      "properties": {
        "particleml_version": {"const": "0.4.0"},
        "python_version": {"type": "string"},
        "git_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"}
      }
    },
    "model_input_fields": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "model_input_sha256": {"$ref": "#/$defs/sha256"},
    "error": {"type": ["string", "null"]}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
