{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://particleml.local/schemas/2.0.0/analysis-freeze.schema.json",
  "title": "particleML analysis freeze",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "freeze_id",
    "created_at",
    "config_sha256",
    "catalog_sha256",
    "dataset_manifest_sha256",
    "prediction_sha256",
    "template_sha256",
    "gates",
    "observed_fit_authorized",
    "freeze_sha256"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "freeze_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "config_sha256": {"$ref": "#/$defs/sha256"},
    "catalog_sha256": {"$ref": "#/$defs/sha256"},
    "dataset_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "prediction_sha256": {"$ref": "#/$defs/sha256"},
    "template_sha256": {"$ref": "#/$defs/sha256"},
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mc_spearman",
        "data_sideband_spearman",
        "sideband_acceptance",
        "spurious_signal"
      ],
      "properties": {
        "mc_spearman": {"const": true},
        "data_sideband_spearman": {"const": true},
        "sideband_acceptance": {"const": true},
        "spurious_signal": {"const": true}
      }
    },
    "observed_fit_authorized": {"const": true},
    "freeze_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
