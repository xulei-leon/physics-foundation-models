{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://particleml.local/schemas/2.0.0/split-manifest.schema.json",
  "title": "particleML deterministic event split manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "algorithm",
    "identity_fields",
    "fractions",
    "dataset_manifest_sha256",
    "counts_by_dataset"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "algorithm": {"const": "sha256-bucket-v1"},
    "identity_fields": {
      "const": ["dataset_id", "file_checksum", "entry_index"]
    },
    "fractions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["train", "calibration", "validation", "test"],
      "properties": {
        "train": {"const": 0.7},
        "calibration": {"const": 0.1},
        "validation": {"const": 0.1},
        "test": {"const": 0.1}
      }
    },
    "dataset_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "counts_by_dataset": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["train", "calibration", "validation", "test"],
        "properties": {
          "train": {"type": "integer", "minimum": 0},
          "calibration": {"type": "integer", "minimum": 0},
          "validation": {"type": "integer", "minimum": 0},
          "test": {"type": "integer", "minimum": 0}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
